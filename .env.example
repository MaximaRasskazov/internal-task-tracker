# Generate a real .env with: cd backend && uv run python -m app.cli.init_env
# This file documents names only. Replace every placeholder before use.
APP_ENV=local
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_RUNTIME_PASSWORD
POSTGRES_OWNER_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_OWNER_PASSWORD
DATABASE_URL=postgresql+asyncpg://tracker:REPLACE_WITH_RANDOM_RUNTIME_PASSWORD@localhost:5433/tracker
MIGRATION_DATABASE_URL=postgresql+asyncpg://tracker_owner:REPLACE_WITH_DIFFERENT_RANDOM_OWNER_PASSWORD@localhost:5433/tracker
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DEMO_PASSWORD=REPLACE_WITH_DEMO_PASSWORD_AT_LEAST_12_CHARACTERS
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_SECONDS=28800
API_LOCK_TIMEOUT_MS=3000
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=INFO
DOCS_ENABLED=true
# For CLI bootstrap only; never commit a real password.
# BOOTSTRAP_ADMIN_EMAIL=you@example.test
# BOOTSTRAP_ADMIN_NAME=Administrator
# BOOTSTRAP_ADMIN_PASSWORD=SET_IN_YOUR_LOCAL_ENVIRONMENT
# Tests use a separate database ending in _test:
# TEST_DATABASE_URL=postgresql+asyncpg://tracker:...@localhost:5433/tracker_test
# TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://tracker_owner:...@localhost:5433/tracker_test
